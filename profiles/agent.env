# Perfil: agente de código (OpenCode / Claude Code / Codex)
#
# Objetivo: contexto largo y estabilidad, no latencia por pulsación.
#   - 64K de contexto para sostener tareas multi-archivo.
#   - Modelo grande (gpt-oss:20b) que ocupa ~12 GB de VRAM.
#   - Paralelismo 1: cada slot extra multiplica la KV cache.
#
# Con este perfil el autocompletado inline NO convive bien: un modelo de 20B
# + un coder de 1.5B caben, pero cada recarga cuesta segundos. Para alternar
# entre agente y autocompletado usa el perfil `hybrid`.

OLLAMA_VULKAN=1
OLLAMA_CONTEXT_LENGTH=65536
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Metadato para los scripts (no se escribe en systemd)
OLLAMA_DEFAULT_MODEL=gpt-oss:20b
