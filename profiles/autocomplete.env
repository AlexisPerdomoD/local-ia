# Perfil: autocompletado inline (Neovim + minuet)
#
# Objetivo: latencia mínima por pulsación.
#   - Contexto pequeño: menos KV cache y menos tokens de prompt.
#   - Modelo caliente: nunca pagar la carga en frío.
#   - Dos modelos en memoria: permite convivir con un modelo de chat.
#
# Medido en RX 9060 XT (16 GB, Vulkan) con qwen2.5-coder:1.5b, num_ctx=4096:
#   warm TTFT 9 ms | 64 tokens en 380 ms (~174 tok/s) | cold 1.7 s
#
# IMPORTANTE: cambiar OLLAMA_CONTEXT_LENGTH reinicia el modelo en la siguiente
# petición (recarga completa). Fija el valor una vez y no lo muevas por request.

OLLAMA_VULKAN=1
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Metadato para los scripts (no se escribe en systemd)
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:1.5b
