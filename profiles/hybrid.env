# Perfil: híbrido (autocompletado + agente en la misma sesión)
#
# Objetivo: usar Neovim con ghost text y OpenCode a la vez sin recargar modelos.
#   - 32K de contexto: suficiente para el agente en tareas acotadas.
#   - Dos modelos cargados: gpt-oss:20b (~12 GB) + coder 1.5b (~1.7 GB).
#   - keep_alive largo: el coste de carga se paga una vez por sesión.
#
# Vigila la VRAM: 12 GB + 1.7 GB + buffers deja poco margen en 16 GB. Si el
# driver empieza a hacer swap a GTT/RAM, baja a `agent` o usa un coder más
# pequeño (qwen2.5-coder:0.5b) o cuantización menor.

OLLAMA_VULKAN=1
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Metadato para los scripts (no se escribe en systemd)
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:1.5b
