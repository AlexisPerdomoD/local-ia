# Perfil: diagnóstico / conservador
#
# Objetivo: aislar problemas. Sin Flash Attention ni cuantización de KV cache,
# contexto corto y un solo modelo. Si un modelo falla aquí y funciona con
# `autocomplete`, el problema está en la optimización, no en el modelo.
#
# Úsalo cuando veas en `journalctl -u ollama.service`:
#   - errores de Vulkan / shader
#   - resultados corruptos o texto repetido
#   - cierres del runner al cargar

OLLAMA_VULKAN=1
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_DEBUG=1

# Metadato para los scripts (no se escribe en systemd)
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:1.5b
